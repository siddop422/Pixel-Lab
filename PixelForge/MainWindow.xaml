<Window x:Class="PixelForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixelForge" Height="820" Width="1360" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}">
    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Top" Background="#20232B" BorderBrush="#343945" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#8B7CFF" CornerRadius="7" Width="30" Height="30" Margin="0,0,9,0">
                        <TextBlock Text="P" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PixelForge" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="DESKTOP STUDIO" FontSize="9" Foreground="{StaticResource TextMuted}" CharacterSpacing="1.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="＋  Import image" Click="Open_Click" Background="#5147A5" BorderBrush="#7165D8"/>
                    <Button Content="Export" Click="Export_Click"/>
                    <Button Content="Fit canvas" Click="Fit_Click"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="LOCAL WORKSPACE" Foreground="{StaticResource TextMuted}" FontSize="10"
                           HorizontalAlignment="Right" VerticalAlignment="Center" CharacterSpacing="1.2"/>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#20232B" BorderBrush="#343945" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready · Import an image to begin" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                <TextBlock x:Name="ZoomText" Grid.Column="1" Text="100%" FontSize="11" Foreground="{StaticResource TextMuted}"/>
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="66"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#20232B" BorderBrush="#343945" BorderThickness="0,0,1,0">
                <StackPanel Margin="7,12">
                    <Button Content="↖" ToolTip="Move tool (coming next)" FontSize="20" Padding="5" Height="42"/>
                    <Button Content="▣" ToolTip="Selection tool (coming next)" FontSize="19" Padding="5" Height="42"/>
                    <Button Content="✎" ToolTip="Brush tool (coming next)" FontSize="19" Padding="5" Height="42"/>
                    <Button Content="◩" ToolTip="Eraser tool (coming next)" FontSize="19" Padding="5" Height="42"/>
                    <Button Content="T" ToolTip="Text tool (coming next)" FontSize="18" Padding="5" Height="42"/>
                    <Button Content="⌗" ToolTip="Crop tool (coming next)" FontSize="19" Padding="5" Height="42"/>
                    <Border Height="1" Background="#3A3F4B" Margin="5,12"/>
                    <Button Content="＋" Click="ZoomIn_Click" ToolTip="Zoom in" FontSize="19" Padding="5" Height="42"/>
                    <Button Content="－" Click="ZoomOut_Click" ToolTip="Zoom out" FontSize="19" Padding="5" Height="42"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#111318" Padding="22">
                <Grid>
                    <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="CanvasHost" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Background="#252932" BorderBrush="#414754" BorderThickness="1">
                                <Canvas x:Name="DocumentCanvas" Background="#252932" ClipToBounds="True"/>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                    <Border x:Name="WelcomePanel" Background="#17191F" CornerRadius="12" Padding="36"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="66" Height="66" CornerRadius="16" Background="#302B55" Margin="0,0,0,18">
                                <TextBlock Text="✦" FontSize="34" Foreground="#A99FFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Your creative workspace" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Import a photo to start editing. Your files stay on this PC."
                                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource TextMuted}"
                                       Margin="0,10,0,20" FontSize="13"/>
                            <Button Content="＋  Open an image" Click="Open_Click" Background="#5147A5" BorderBrush="#7165D8"
                                    HorizontalAlignment="Center" Padding="20,10"/>
                            <TextBlock Text="PNG  ·  JPEG  ·  BMP  ·  TIFF" FontSize="10" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,17,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#20232B" BorderBrush="#343945" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="LAYERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" CharacterSpacing="1.5" Margin="2,5,0,12"/>
                        <DockPanel Margin="0,0,0,9">
                            <TextBlock Text="Document layers" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="＋" Padding="8,4" Click="Open_Click" ToolTip="Import another image as a layer"/>
                        </DockPanel>
                        <ListBox x:Name="LayersList" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMain}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#292D37" CornerRadius="6" Padding="8" Margin="0,2">
                                        <DockPanel>
                                            <CheckBox IsChecked="{Binding IsVisible, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"
                                                      ToolTip="Show or hide layer"/>
                                            <TextBlock Text="▧" Foreground="#A99FFF" FontSize="17" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Height="1" Background="#3A3F4B" Margin="0,18,0,16"/>
                        <TextBlock Text="PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" CharacterSpacing="1.5" Margin="2,0,0,12"/>
                        <TextBlock Text="Selected layer" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="SelectedLayerText" Text="No layer selected" FontSize="13" Margin="0,5,0,14"/>
                        <TextBlock Text="Canvas size" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock x:Name="CanvasSizeText" Text="—" FontSize="13" Margin="0,5,0,14"/>
                        <TextBlock Text="Layer visibility" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Text="Use the checkbox beside a layer to show or hide it."
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
                        <Border Height="1" Background="#3A3F4B" Margin="0,18,0,16"/>
                        <TextBlock Text="NEXT UP" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMuted}" CharacterSpacing="1.5" Margin="2,0,0,8"/>
                        <TextBlock Text="Brush engine · Crop · Text layers · Adjustments · Undo/redo"
                                   TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
