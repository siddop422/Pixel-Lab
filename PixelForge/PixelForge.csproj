<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PixelForge</AssemblyName>
    <RootNamespace>PixelForge</RootNamespace>
    <ApplicationIcon>Assets\PixelForge.ico</ApplicationIcon>
    <Version>2.1.0</Version>
    <Product>PixelForge</Product>
    <Description>PixelForge 2.1 — lightweight offline Windows image editor.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\PixelForge-Logo.png" />
    <Resource Include="Assets\PixelForge.ico" />
  </ItemGroup>
</Project>